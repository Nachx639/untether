#!/bin/bash
# The Untether CLI from this checkout's source (tsx), for when the installed app's `ut` is older
# than a server running in development from this checkout (2026-10-31: the app's ut answered
# "unknown command: ut project connector"). The server names this file in that error and in the
# doctor's cli-build warning: `untether-dev task …` / `untether-dev project …`.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
WEB_DIR="$(cd "$(dirname "$SOURCE")/.." && pwd)"
TSX="$WEB_DIR/node_modules/.bin/tsx"
if [ ! -x "$TSX" ]; then
    echo "Error: $TSX not found; run pnpm install in $WEB_DIR" >&2
    exit 1
fi
exec "$TSX" "$WEB_DIR/src/cli.ts" "$@"
