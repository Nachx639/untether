        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি পোর্ট %@-এ শোনা প্রসেসটি জোর করে বন্ধ করে, তারপর সার্ভার চালু করে।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto fuerza el cierre del proceso que escucha en el puerto %@ y después inicia el servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
