    "So Untether can open terminals for you and tell you when an agent needs you." : {
      "comment" : "Welcome window (RequestPermissionsPageView.swift)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حتى يتمكن Untether من فتح الطرفيات لك وإعلامك عندما يحتاج إليك وكيل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যাতে Untether আপনার জন্য টার্মিনাল খুলতে পারে এবং কোনো এজেন্টের আপনাকে দরকার হলে জানাতে পারে।"
          }
        },
        "es" : {
          "stringUnit" : {
