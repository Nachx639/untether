        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ হিসেবে সাইন ইন করে। SSH কী থাকলে ব্রাউজারে আপনার Mac পাসওয়ার্ড লিখতে হয় না।"
