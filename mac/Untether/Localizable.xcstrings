          }
        }
      }
    },
    "Untether needs Accessibility permission to send keystrokes to %@.\n\nPlease grant permission in System Settings > Privacy & Security > Accessibility." : {
      "comment" : "Alert message: Accessibility permission missing. Placeholder: terminal app name. Use the macOS names of System Settings panes in your language",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج Untether إلى إذن إمكانية الوصول لإرسال ضغطات المفاتيح إلى %@.\n\nيُرجى منح الإذن في إعدادات النظام ← الخصوصية والأمن ← إمكانية الوصول."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-এ কীস্ট্রোক পাঠাতে Untether-এর অ্যাক্সেসিবিলিটি অনুমতি প্রয়োজন।\n\nঅনুগ্রহ করে সিস্টেম সেটিংস > গোপনীয়তা ও নিরাপত্তা > অ্যাক্সেসিবিলিটি-তে অনুমতি দিন।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untether necesita el permiso de Accesibilidad para enviar pulsaciones de teclas a %@.\n\nConcédelo en Ajustes del Sistema > Privacidad y seguridad > Accesibilidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untether a besoin de l’autorisation Accessibilité pour envoyer des frappes au clavier à %@.\n\nAccordez-la dans Réglages Système > Confidentialité et sécurité > Accessibilité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ को कीस्ट्रोक भेजने के लिए Untether को एक्सेसिबिलिटी अनुमति चाहिए।\n\nकृपया सिस्टम सेटिंग्स > गोपनीयता और सुरक्षा > एक्सेसिबिलिटी में अनुमति दें।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Untether precisa da permissão de Acessibilidade para enviar teclas para %@.\n\nConceda a permissão em Ajustes do Sistema > Privacidade e Segurança > Acessibilidade."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untether 需要辅助功能权限才能向 %@ 发送按键。\n\n请在“系统设置 > 隐私与安全性 > 辅助功能”中授予权限。"
          }
        }
      }
    },
    "Untether needs Accessibility permission to send keystrokes to terminal applications." : {
      "comment" : "Error detail: why launching a terminal failed",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج Untether إلى إذن إمكانية الوصول لإرسال ضغطات المفاتيح إلى تطبيقات الطرفية."
