    "Remote devices sign in with your Mac password or an SSH key. Untether never stores your password." : {
      "comment" : "Welcome window (AccessDashboardPageView.swift)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسجّل الأجهزة البعيدة الدخول بكلمة سر Mac أو بمفتاح SSH. لا يخزّن Untether كلمة السر أبدًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "রিমোট ডিভাইস আপনার Mac পাসওয়ার্ড বা SSH কী দিয়ে সাইন ইন করে। Untether কখনো আপনার পাসওয়ার্ড সংরক্ষণ করে না।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los dispositivos remotos inician sesión con la contraseña de tu Mac o con una clave SSH. Untether nunca guarda tu contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les appareils distants se connectent avec le mot de passe de votre Mac ou une clé SSH. Untether n’enregistre jamais votre mot de passe."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रिमोट डिवाइस आपके Mac पासवर्ड या SSH की से साइन इन करते हैं। Untether आपका पासवर्ड कभी सेव नहीं करता।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dispositivos remotos entram com a senha do seu Mac ou uma chave SSH. O Untether nunca guarda sua senha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "远程设备使用你的 Mac 密码或 SSH 密钥登录。Untether 从不存储你的密码。"
          }
        }
