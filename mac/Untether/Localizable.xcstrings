    "Untether has been moved to Applications. Would you like to quit this version and launch the one in Applications?" : {
      "comment" : "Alert: the app was moved to Applications, message",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم نقل Untether إلى مجلد التطبيقات. هل تريد إنهاء هذه النسخة وتشغيل النسخة الموجودة في مجلد التطبيقات؟"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untether-কে Applications-এ সরানো হয়েছে। এই সংস্করণ বন্ধ করে Applications-এরটি চালু করতে চান?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untether se ha movido a Aplicaciones. ¿Quieres cerrar esta copia y abrir la de Aplicaciones?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untether a été déplacé dans Applications. Voulez-vous quitter cette version et ouvrir celle d’Applications ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untether को Applications में ले जाया गया है। क्या आप यह वर्शन बंद करके Applications वाला वर्शन शुरू करना चाहेंगे?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Untether foi movido para Aplicativos. Deseja encerrar esta versão e abrir a que está em Aplicativos?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untether 已移到“应用程序”。要退出此版本并启动“应用程序”中的版本吗？"
          }
        }
      }
    },
    "Untether hears about sessions as they happen." : {
      "comment" : "Settings, Notifications (NotificationSettingsView.swift)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعلم Untether بالجلسات لحظة حدوثها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untether সেশনের ঘটনা ঘটার সঙ্গে সঙ্গে জানতে পারে।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untether se entera de lo que pasa en las sesiones al momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untether est informé des sessions en temps réel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untether को सेशन की हलचल उसी समय पता चलती है।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Untether fica sabendo das sessões na hora em que acontecem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untether 会实时获知会话动态。"
          }
        }
      }
    },
    "Untether is already running" : {
