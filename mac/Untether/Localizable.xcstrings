          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untether a besoin de l’autorisation Accessibilité pour envoyer des frappes au clavier aux apps de terminal."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टर्मिनल ऐप्लिकेशन को कीस्ट्रोक भेजने के लिए Untether को एक्सेसिबिलिटी अनुमति चाहिए।"
          }
